includes:
    - phpstan-baseline.neon
parameters:
    level: 0
    paths:
        - .
    scanFiles:
        - sys/Parsedown/Parsedown.php
        - services/Authentication/SAML/lib/Saml2/Settings.php
        - services/Authentication/SAML/lib/Saml2/Auth.php
        - sys/Session/SessionInterface.php
    scanDirectories:
        - vendor
        - sys/File
        - services/Authentication/SAML/extlib/xmlseclibs
        - services/Authentication/SAML/extlib/xmlseclibs
        - sys/Email/PHPMailer-6.9.1
    excludePaths:
        analyse:
            - Minify/*
            - vendor/*
            - services/WebBuilder/Template.php
            - services/Authentication/SAML/extlib/xmlseclibs/*
            - services/Authentication/SAML/lib/Saml2/Auth.php
            - sys/Parsedown/Parsedown.php
            - sys/mobileesp/mdetect.php
            - sys/mobile_device_detect.php
            - sys/Session/SessionInterface.php
            - sys/Smarty/sysplugins/*
            - sys/Email/PHPMailer-6.9.1/
            - sys/File/MARC/*
            - sys/Smarty/plugins/*
            - CAS-1.3.4/*
            - services/Authentication/SAML/lib/Saml2/Settings.php