includes:
    - phpstan-baseline.neon
parameters:
    level: 0
    paths:
        - .
    scanFiles:
        - sys/Session/SessionInterface.php
        - sys/Session/MySQLSession.php
        - Drivers/SIP2Driver.php
        - RecordDrivers/Axis360RecordDriver.php
        - RecordDrivers/HooplaRecordDriver.php
        - RecordDrivers/MarcRecordDriver.php
        - RecordDrivers/OverDriveRecordDriver.php
        - RecordDrivers/PalaceProjectRecordDriver.php
        - services/SnapPay/Complete.php
        - services/Authentication/OAuth2_Token.php
        - services/Authentication/OAuth2_Authorize.php
    scanDirectories:
        - vendor
        - sys/File/MARC
        - sys/Authentication/OAuth2
    excludePaths:
        analyse:
            - sys/File/MARC
            - services/Authentication/OAuth2_Authorize.php
            - services/Authentication/OAuth2_Token.php
            - sys/Authentication/OAuth2/*
            - vendor/*
            - sys/Session/MySQLSession.php    
            - sys/Session/SessionInterface.php 
            - sys/mobileesp/mdetect.php
            - sys/mobile_device_detect.php
            - Minify/FirePHP.php
            - Minify/ImportProcessor.php
            - Drivers/SIP2Driver.php
            - RecordDrivers/Axis360RecordDriver.php
            - RecordDrivers/HooplaRecordDriver.php
            - RecordDrivers/MarcRecordDriver.php
            - RecordDrivers/OverDriveRecordDriver.php
            - RecordDrivers/PalaceProjectRecordDriver.php
            - services/SnapPay/Complete.php